<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rhino major version to build against. One source tree, two Yak
    distributions:
      dotnet build -c Release -p:RhinoMajor=9   (default, rh9)
      dotnet build -c Release -p:RhinoMajor=8   (rh8)
    Both target net8.0: Rhino 8 hosts .NET 8 and Rhino 9 (.NET 10) loads
    net8.0 plug-ins through runtime roll-forward.
  -->
  <PropertyGroup>
    <RhinoMajor Condition="'$(RhinoMajor)' == ''">9</RhinoMajor>
    <RhinoCommonVersion Condition="'$(RhinoMajor)' == '9'">9.0.26300.9401</RhinoCommonVersion>
    <RhinoCommonVersion Condition="'$(RhinoMajor)' == '8'">8.36.26296.17001</RhinoCommonVersion>
    <!-- Set -p:SkipPluginCopy=true to build without copying into a local Rhino install. -->
    <SkipPluginCopy Condition="'$(SkipPluginCopy)' == ''">false</SkipPluginCopy>
  </PropertyGroup>

  <!--
    Developer contact: the single source for the plug-in's PlugInDescription
    attributes, Authors / Copyright, and the Yak manifest (scripts/publish-yak.sh
    injects these into manifest.yml). tests/test_developer_metadata.py keeps
    pyproject.toml in step.
  -->
  <PropertyGroup>
    <DeveloperName>EaseHee</DeveloperName>
    <DeveloperEmail>26100044@snut.ac.kr</DeveloperEmail>
    <DeveloperCountry>South Korea</DeveloperCountry>
    <!-- No public postal address or phone; "-" is the placeholder McNeel's own ConstraintsUI ships with. -->
    <DeveloperAddress>-</DeveloperAddress>
    <DeveloperPhone>-</DeveloperPhone>
    <RepositoryUrl>https://github.com/EaseHee/rhino-mcp</RepositoryUrl>
  </PropertyGroup>

  <!--
    The seven fields RhinoCore has load checks for ("Unable to load %s plug-in:
    developer ... not specified"); McNeel's own plug-ins declare the same set.
    Fax has no check. Rhino's plug-in error dialog shows "The developer did not
    include any contact details" when it has no field to list, including load
    failures that stop before the attributes are read; that text accompanies a
    load failure, it is not the cause.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.Organization</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(DeveloperName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.Address</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(DeveloperAddress)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.Phone</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(DeveloperPhone)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.Email</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(DeveloperEmail)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.WebSite</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(RepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.UpdateUrl</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(RepositoryUrl)/releases</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
      <_Parameter1>Rhino.PlugIns.DescriptionType.Country</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(DeveloperCountry)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <Title>rhino-mcp</Title>
    <Description>rhino-mcp plugin for Rhino 8 and Rhino 9 — JSON-RPC 2.0 over a platform-native transport.</Description>
    <Version>0.7.2</Version>
    <Authors>$(DeveloperName) &lt;$(DeveloperEmail)&gt;</Authors>
    <Copyright>Copyright (c) 2026 $(DeveloperName) &lt;$(DeveloperEmail)&gt;</Copyright>
    <AssemblyName>rhino-mcp</AssemblyName>
    <RootNamespace>RhinoMcp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(RhinoMajor)' == '9'">$(DefineConstants);RHINO9</DefineConstants>
    <!-- Keep per-major outputs apart so rh8 and rh9 builds never overwrite each other. -->
    <BaseOutputPath>bin/rh$(RhinoMajor)/</BaseOutputPath>
  </PropertyGroup>

  <Target Name="ValidateRhinoMajor" BeforeTargets="Restore;CollectPackageReferences">
    <Error Condition="'$(RhinoCommonVersion)' == ''" Text="Unsupported RhinoMajor '$(RhinoMajor)'; expected 8 or 9." />
  </Target>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="$(RhinoCommonVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <!-- macOS: copy into the matching Rhino.app bundle when it is installed. -->
  <PropertyGroup>
    <MacPluginDir>/Applications/Rhino $(RhinoMajor).app/Contents/PlugIns/</MacPluginDir>
    <WinPluginDir>$(APPDATA)/McNeel/Rhinoceros/$(RhinoMajor).0/Plug-ins/rhino-mcp/</WinPluginDir>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(SkipPluginCopy)' != 'true'">
    <Message Importance="high" Text="Rhino $(RhinoMajor).app not found; skipping plug-in copy." Condition="!Exists('$(MacPluginDir)')" />
    <Exec Command="cp '$(TargetDir)rhino-mcp.rhp' '$(MacPluginDir)'" Condition="Exists('$(MacPluginDir)')" />
    <Exec Command="cp '$(TargetDir)Newtonsoft.Json.dll' '$(MacPluginDir)'" Condition="Exists('$(MacPluginDir)') And Exists('$(TargetDir)Newtonsoft.Json.dll')" />
  </Target>

  <!-- Windows: copy to the per-major Plug-ins folder. -->
  <Target Name="PostBuildWin" AfterTargets="PostBuildEvent" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(SkipPluginCopy)' != 'true'">
    <Copy SourceFiles="$(TargetDir)rhino-mcp.rhp" DestinationFolder="$(WinPluginDir)" />
    <Copy SourceFiles="$(TargetDir)Newtonsoft.Json.dll" DestinationFolder="$(WinPluginDir)" Condition="Exists('$(TargetDir)Newtonsoft.Json.dll')" />
  </Target>

</Project>
